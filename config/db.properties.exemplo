# Configuração do banco.
#
# No computador da loja o INSTALADOR cria este arquivo sozinho (com senhas sorteadas), em
#     C:\ProgramData\SistemaPDV\db.properties
# Este modelo serve para o desenvolvimento (copie para config\db.properties) ou para montar
# à mão um PC sem o instalador. O sistema procura a configuração nesta ordem:
#   1. -Dpdv.config=caminho (se informado ao abrir o programa)
#   2. config\db.properties na pasta do projeto   (desenvolvimento; fica fora do git)
#   3. C:\ProgramData\SistemaPDV\db.properties   (computador da loja)
# Nunca de dentro do programa (.jar): nenhuma senha vai junto quando o programa é copiado.
#
# Dois usuários, nunca o root:
#   user / password                     -> pdv_app: usado pelo sistema o tempo todo; só lê e altera dados
#   migracao.user / migracao.password   -> pdv_migracao: usado só ao abrir o sistema, para criar/atualizar
#                                          as tabelas (Flyway); tem permissão total, mas só no casarural
#
# Criar no MySQL da loja (no Workbench, como root), com senhas novas e diferentes:
#   CREATE USER 'pdv_app'@'localhost' IDENTIFIED BY '...';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON casarural.* TO 'pdv_app'@'localhost';
#   CREATE USER 'pdv_migracao'@'localhost' IDENTIFIED BY '...';
#   GRANT ALL PRIVILEGES ON casarural.* TO 'pdv_migracao'@'localhost';
# Não é preciso criar o banco nem as tabelas: o sistema faz isso na primeira vez que abrir.

dburl=jdbc:mysql://localhost:3306/casarural?allowPublicKeyRetrieval=true&useSSL=false
user=pdv_app
password=COLOQUE_AQUI_A_SENHA_DO_PDV_APP

migracao.user=pdv_migracao
migracao.password=COLOQUE_AQUI_A_SENHA_DO_PDV_MIGRACAO
