<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Tela principal: menu em blocos e a barra do caixa embaixo. Visual em css/componentes.css -->
<BorderPane styleClass="tela" xmlns:fx="http://javafx.com/fxml" fx:controller="com.casarural.sistemapdv.controller.MainController">

    <top>
        <VBox>
            <MenuBar fx:id="menuPrincipal">
                <Menu text="Sistema">
                    <MenuItem text="Configurações" fx:id="menuConfiguracoes"/>
                    <MenuItem text="Atualizar Dados"/>
                </Menu>
                <Menu text="Ajuda">
                    <MenuItem text="Manual" onAction="#onMenuManualAction"/>
                    <MenuItem text="Problemas e soluções" onAction="#onMenuProblemasAction"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Sobre" onAction="#onMenuSobreAction"/>
                </Menu>
                <Menu text="Relatórios">
                    <MenuItem fx:id="menuPao" text="Pão do dia (F7)" onAction="#onMenuPaoAction"/>
                    <MenuItem text="Lista de compras (F9)" onAction="#onMenuListaComprasAction"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="menuRelatorios" text="Vendas e produtos (F8) — pede o PIN" onAction="#onMenuRelatoriosAction"/>
                </Menu>
            </MenuBar>

            <HBox styleClass="cabecalho" alignment="CENTER_LEFT">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label styleClass="titulo" text="Casa Rural"/>
                    <Label styleClass="subtitulo" text="Ponto de venda"/>
                </VBox>
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label fx:id="labelHora" styleClass="relogio" text="00:00:00"/>
                    <Label fx:id="labelData" styleClass="subtitulo" text="00/00/0000"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <GridPane hgap="22" vgap="22" alignment="CENTER">
            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>

            <Button fx:id="botaoPDV" styleClass="bloco-menu" onAction="#onBotaoPDVAction"
                    prefWidth="270" prefHeight="150" contentDisplay="GRAPHIC_ONLY"
                    GridPane.rowIndex="0" GridPane.columnIndex="0">
                <graphic>
                    <VBox spacing="6" prefWidth="230">
                        <Label styleClass="etiqueta,etiqueta-sucesso" text="F1"/>
                        <Label styleClass="bloco-titulo" text="Venda"/>
                        <Label styleClass="bloco-descricao" wrapText="true" text="Passar produtos e receber o pagamento"/>
                    </VBox>
                </graphic>
            </Button>

            <Button fx:id="botaoProdutos" styleClass="bloco-menu" onAction="#onButtonProductAction"
                    prefWidth="270" prefHeight="150" contentDisplay="GRAPHIC_ONLY"
                    GridPane.rowIndex="0" GridPane.columnIndex="1">
                <graphic>
                    <VBox spacing="6" prefWidth="230">
                        <Label styleClass="etiqueta,etiqueta-neutra" text="F2"/>
                        <Label styleClass="bloco-titulo" text="Produtos"/>
                        <Label styleClass="bloco-descricao" wrapText="true" text="Cadastrar produto ou dar entrada no estoque"/>
                    </VBox>
                </graphic>
            </Button>

            <Button fx:id="botaoConsultarProdutos" styleClass="bloco-menu" onAction="#onButtonProductListAction"
                    prefWidth="270" prefHeight="150" contentDisplay="GRAPHIC_ONLY"
                    GridPane.rowIndex="0" GridPane.columnIndex="2">
                <graphic>
                    <VBox spacing="6" prefWidth="230">
                        <Label styleClass="etiqueta,etiqueta-neutra" text="F3"/>
                        <Label styleClass="bloco-titulo" text="Estoque"/>
                        <Label styleClass="bloco-descricao" wrapText="true" text="Ver, editar e excluir produtos"/>
                    </VBox>
                </graphic>
            </Button>

            <Button fx:id="botaoClientes" styleClass="bloco-menu" onAction="#onButtonCustomerAction"
                    prefWidth="270" prefHeight="150" contentDisplay="GRAPHIC_ONLY"
                    GridPane.rowIndex="1" GridPane.columnIndex="0">
                <graphic>
                    <VBox spacing="6" prefWidth="230">
                        <Label styleClass="etiqueta,etiqueta-neutra" text="F4"/>
                        <Label styleClass="bloco-titulo" text="Novo cliente"/>
                        <Label styleClass="bloco-descricao" wrapText="true" text="Cadastrar um cliente para o fiado"/>
                    </VBox>
                </graphic>
            </Button>

            <Button fx:id="botaoFiados" styleClass="bloco-menu" onAction="#onButtonCustomerListAction"
                    prefWidth="270" prefHeight="150" contentDisplay="GRAPHIC_ONLY"
                    GridPane.rowIndex="1" GridPane.columnIndex="1">
                <graphic>
                    <VBox spacing="6" prefWidth="230">
                        <Label styleClass="etiqueta,etiqueta-alerta" text="F5"/>
                        <Label styleClass="bloco-titulo" text="Clientes e fiado"/>
                        <Label styleClass="bloco-descricao" wrapText="true" text="Consultar clientes e receber pagamentos de fiado"/>
                    </VBox>
                </graphic>
            </Button>

            <Button fx:id="botaoHistorico" styleClass="bloco-menu" onAction="#onBotaoHistoricoAction"
                    prefWidth="270" prefHeight="150" contentDisplay="GRAPHIC_ONLY"
                    GridPane.rowIndex="1" GridPane.columnIndex="2">
                <graphic>
                    <VBox spacing="6" prefWidth="230">
                        <Label styleClass="etiqueta,etiqueta-info" text="Consulta"/>
                        <Label styleClass="bloco-titulo" text="Histórico de vendas"/>
                        <Label styleClass="bloco-descricao" wrapText="true" text="Encontrar vendas anteriores"/>
                    </VBox>
                </graphic>
            </Button>
        </GridPane>
    </center>

    <!-- Barra do caixa: situação, dinheiro na gaveta e ações -->
    <bottom>
        <HBox styleClass="barra-inferior" alignment="CENTER_LEFT" spacing="12.0">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="labelCaixaStatus" styleClass="etiqueta" text="CAIXA FECHADO"/>
                <Label fx:id="labelCaixaGaveta" styleClass="valor-grande" text=""/>
            </VBox>
            <Button fx:id="btnRetirar" text="Retirar dinheiro" onAction="#onRetirarAction" prefHeight="42"/>
            <Button fx:id="btnColocar" text="Colocar dinheiro" onAction="#onColocarAction" prefHeight="42"/>
            <Button text="Histórico de caixas" onAction="#onHistoricoCaixaAction" prefHeight="42"/>
            <Button fx:id="btnCaixaAbrirFechar" styleClass="botao-primario" text="Abrir caixa (F6)"
                    onAction="#onCaixaAbrirFecharAction" prefHeight="42" prefWidth="190"/>
        </HBox>
    </bottom>

</BorderPane>
