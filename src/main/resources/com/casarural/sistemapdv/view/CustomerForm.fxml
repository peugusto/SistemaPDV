<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Edição de cliente (aberta pela lista de clientes) -->
<VBox styleClass="tela" prefWidth="480.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.casarural.sistemapdv.controller.CustomerFormController">

    <VBox styleClass="cabecalho" spacing="2">
        <Label styleClass="titulo" text="Editar cliente"/>
        <Label styleClass="subtitulo" wrapText="true" text="Bloqueado impede novas compras no fiado; a dívida continua."/>
    </VBox>

    <GridPane styleClass="cartao" hgap="14" vgap="14">
        <VBox.margin><Insets top="20" right="24" bottom="8" left="24"/></VBox.margin>
        <columnConstraints>
            <ColumnConstraints minWidth="130"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label styleClass="rotulo" text="Nome" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNome" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label styleClass="rotulo" text="Celular / WhatsApp" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtTelefone" promptText="(00) 00000-0000" maxWidth="220" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label styleClass="rotulo" text="Limite (R$)" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtLimite" maxWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label styleClass="rotulo" text="Situação do fiado" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <ComboBox fx:id="comboBoxStatus" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <!-- Aparece só quando há compra fiada atrasada (bloqueio automático) -->
        <Label fx:id="labelAtraso" styleClass="etiqueta,etiqueta-perigo" wrapText="true" maxWidth="Infinity" prefWidth="380" minHeight="-Infinity"
               visible="false" managed="false" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <padding><Insets top="12" right="24" bottom="22" left="24"/></padding>
        <Button fx:id="btnCancel" text="Cancelar" onAction="#onBtnCancelAction"/>
        <Button fx:id="btnSave" styleClass="botao-primario" text="Salvar" onAction="#onBtnSaveAction"/>
    </HBox>
</VBox>
