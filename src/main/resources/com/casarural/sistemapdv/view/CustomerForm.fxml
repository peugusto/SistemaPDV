<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="TOP_LEFT" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.casarural.sistemapdv.controller.CustomerFormController" prefWidth="400.0">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Editar Cliente" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Separator/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="100" prefWidth="100" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="30" />
            <RowConstraints minHeight="30" />
            <RowConstraints minHeight="30" />
        </rowConstraints>

        <Label text="Nome:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNome" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Limite Crédito:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtLimite" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Situação Fiado:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="comboBoxStatus" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="150.0"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <padding>
            <Insets top="10"/>
        </padding>
        <Button fx:id="btnSave" text="Salvar" onAction="#onBtnSaveAction" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Button fx:id="btnCancel" text="Cancelar" onAction="#onBtnCancelAction" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-cursor: hand;"/>
    </HBox>
</VBox>