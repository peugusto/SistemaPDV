<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Lista de compras da semana: o que vendeu nos últimos 7 dias menos o que tem no estoque -->
<BorderPane styleClass="tela" prefWidth="1000" prefHeight="720" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.casarural.sistemapdv.controller.ListaComprasController">

    <top>
        <VBox styleClass="cabecalho" spacing="2">
            <Label styleClass="titulo" text="Lista de compras"/>
            <Label fx:id="lblPeriodo" styleClass="subtitulo" text=""/>
        </VBox>
    </top>

    <center>
        <VBox spacing="14">
            <BorderPane.margin><Insets top="16" right="24" bottom="8" left="24"/></BorderPane.margin>

            <HBox spacing="12">
                <VBox styleClass="indicador" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label styleClass="indicador-rotulo" text="PRODUTOS PARA REPOR"/>
                    <Label fx:id="lblQtdProdutos" styleClass="indicador-valor" text="0"/>
                </VBox>
                <VBox styleClass="indicador" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label styleClass="indicador-rotulo" text="JÁ ACABARAM"/>
                    <Label fx:id="lblAcabaram" styleClass="indicador-valor" text="0"/>
                </VBox>
                <VBox styleClass="indicador" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label styleClass="indicador-rotulo" text="UNIDADES PARA COMPRAR"/>
                    <Label fx:id="lblUnidades" styleClass="indicador-valor" text="0"/>
                </VBox>
            </HBox>

            <VBox styleClass="cartao" spacing="8" VBox.vgrow="ALWAYS">
                <Label styleClass="texto-dica" wrapText="true"
                       text="Quanto comprar = o que vendeu nos últimos 7 dias menos o que tem no estoque. Mude a quantidade se quiser; 0 tira da lista. Pão, açaí e pesáveis ficam de fora."/>
                <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <placeholder><Label styleClass="texto-suave" text="Nada para repor: o estoque cobre as vendas da semana."/></placeholder>
                    <columns>
                        <TableColumn fx:id="colComprar" text="COMPRAR" prefWidth="110" sortable="false"/>
                        <TableColumn fx:id="colProduto" text="PRODUTO" prefWidth="300"/>
                        <TableColumn fx:id="colVendeu" text="VENDEU (7 DIAS)" prefWidth="130"/>
                        <TableColumn fx:id="colTem" text="TEM NO ESTOQUE" prefWidth="130"/>
                        <TableColumn fx:id="colSituacao" text="SITUAÇÃO" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="barra-inferior" spacing="10" alignment="CENTER_RIGHT">
            <Label fx:id="lblCopiado" styleClass="texto-suave" wrapText="true"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Atualizar" onAction="#onAtualizar"/>
            <Button styleClass="botao-primario" text="Copiar lista" onAction="#onCopiar"/>
        </HBox>
    </bottom>
</BorderPane>
