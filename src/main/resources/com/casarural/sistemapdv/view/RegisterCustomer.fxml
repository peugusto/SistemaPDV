<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Cadastro de cliente novo -->
<VBox styleClass="tela" prefWidth="540" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.casarural.sistemapdv.controller.RegisterCustomerController">

    <VBox styleClass="cabecalho" spacing="2">
        <Label styleClass="titulo" text="Novo cliente"/>
        <Label styleClass="subtitulo" text="O limite é o máximo que o cliente pode ficar devendo no fiado."/>
    </VBox>

    <GridPane styleClass="cartao" hgap="14" vgap="14">
        <VBox.margin><Insets top="20" right="24" bottom="8" left="24"/></VBox.margin>
        <columnConstraints>
            <ColumnConstraints minWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label styleClass="rotulo" text="Nome completo" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNome" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label styleClass="rotulo" text="Celular / WhatsApp" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPhoneNumber" promptText="(00) 00000-0000" maxWidth="220"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label styleClass="rotulo" text="Limite de crédito (R$)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtLimite" promptText="0,00" maxWidth="160" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <padding><Insets top="12" right="24" bottom="22" left="24"/></padding>
        <Button text="Limpar" fx:id="btnClear"/>
        <Button text="Cancelar" fx:id="btnCancel" onAction="#onBtnCancelAction"/>
        <Button text="Salvar" fx:id="btnSave" styleClass="botao-primario" onAction="#onBtnSaveAction"/>
    </HBox>
</VBox>
