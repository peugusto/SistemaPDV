<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Cadastro de produto / entrada de estoque (código já existente: só soma estoque) -->
<VBox styleClass="tela" prefWidth="560" xmlns:fx="http://javafx.com/fxml" fx:controller="com.casarural.sistemapdv.controller.CadastroProdutosController">

    <VBox styleClass="cabecalho" spacing="2">
        <Label styleClass="titulo" text="Produto"/>
        <Label styleClass="subtitulo" wrapText="true" text="Digite o código e aperte Enter. Se já existir, você só informa quanto chegou."/>
    </VBox>

    <GridPane styleClass="cartao" hgap="14" vgap="14">
        <VBox.margin><Insets top="20" right="24" bottom="8" left="24"/></VBox.margin>
        <columnConstraints>
            <ColumnConstraints minWidth="140"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label styleClass="rotulo" text="Código de barras" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCodBarras" promptText="Passe o leitor ou digite e aperte Enter" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label styleClass="rotulo" text="Nome do produto" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNome" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label styleClass="rotulo" text="Preço (R$)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPreco" promptText="0,00" maxWidth="160" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label styleClass="rotulo" text="Quantidade" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEstoque" promptText="0" maxWidth="160" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label styleClass="rotulo" text="Fiado" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <VBox spacing="4" GridPane.rowIndex="4" GridPane.columnIndex="1">
            <CheckBox fx:id="chkPermiteFiado" text="Pode vender no fiado" selected="true"/>
            <Label styleClass="texto-dica" wrapText="true"
                   text="Desmarque para cigarro, bebida alcoólica e outros produtos que só podem ser pagos na hora."/>
        </VBox>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <padding><Insets top="12" right="24" bottom="22" left="24"/></padding>
        <Button text="Limpar" fx:id="botaoLimpar"/>
        <Button text="Cancelar" fx:id="botaoCancelar" onAction="#onBotaoCancelarAction"/>
        <Button text="Salvar" fx:id="botaoSalvar" styleClass="botao-primario" onAction="#onBotaoSalvarAction"/>
    </HBox>
</VBox>
