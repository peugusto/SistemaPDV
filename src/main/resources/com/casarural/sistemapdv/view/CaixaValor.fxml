<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Tela pequena usada para: abrir o caixa (troco inicial), retirar dinheiro (sangria) e colocar dinheiro (reforço) -->
<VBox styleClass="tela" prefWidth="480.0" spacing="0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.casarural.sistemapdv.controller.CaixaValorController">
    <children>
        <VBox styleClass="cabecalho" spacing="4">
            <children>
                <Label fx:id="labelTitulo" styleClass="titulo" text="Abrir caixa" />
                <Label fx:id="labelExplicacao" styleClass="subtitulo" wrapText="true" text="Quanto dinheiro tem na gaveta agora?" />
            </children>
        </VBox>

        <VBox styleClass="cartao" spacing="10">
            <VBox.margin><Insets top="20.0" right="24.0" bottom="8.0" left="24.0" /></VBox.margin>
            <children>
                <Label fx:id="labelInfo" styleClass="texto-sucesso" text="" visible="false" managed="false" />
                <Label styleClass="rotulo-secao" text="VALOR (R$)" />
                <TextField fx:id="campoValor" styleClass="campo-grande" promptText="0,00" />

                <VBox fx:id="boxMotivo" spacing="6.0">
                    <children>
                        <Label styleClass="rotulo-secao" text="MOTIVO">
                            <VBox.margin><Insets top="6.0" /></VBox.margin>
                        </Label>
                        <TextField fx:id="campoMotivo" promptText="Ex.: pagamento do fornecedor de ração" />
                    </children>
                </VBox>
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <padding><Insets top="12.0" right="24.0" bottom="22.0" left="24.0" /></padding>
            <children>
                <Button fx:id="btnCancelar" onAction="#onCancelar" text="Cancelar" minHeight="44.0" minWidth="120.0" />
                <Button fx:id="btnConfirmar" styleClass="botao-primario" onAction="#onConfirmar" text="Abrir caixa" defaultButton="true" minHeight="44.0" minWidth="170.0" />
            </children>
        </HBox>
    </children>
</VBox>
