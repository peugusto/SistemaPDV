<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Tela pequena usada para: abrir o caixa (troco inicial), retirar dinheiro (sangria) e colocar dinheiro (reforço) -->
<VBox prefWidth="460.0" spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.casarural.sistemapdv.controller.CaixaValorController"
      style="-fx-background-color: #2c3e50;">
    <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>
    <children>
        <Label fx:id="labelTitulo" text="ABRIR CAIXA" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />
        <Label fx:id="labelExplicacao" wrapText="true" text="Quanto dinheiro tem na gaveta agora?" style="-fx-font-size: 14px; -fx-text-fill: #bdc3c7;" />
        <Label fx:id="labelInfo" text="" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;" />

        <Label text="Valor (R$)" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;" />
        <TextField fx:id="campoValor" promptText="0,00" prefHeight="46.0" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

        <VBox fx:id="boxMotivo" spacing="6.0">
            <children>
                <Label text="Motivo" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;" />
                <TextField fx:id="campoMotivo" promptText="Ex.: pagamento do fornecedor de ração" prefHeight="40.0" style="-fx-font-size: 15px;" />
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <padding><Insets top="8.0" /></padding>
            <children>
                <Button fx:id="btnCancelar" onAction="#onCancelar" text="Cancelar" prefHeight="44.0" prefWidth="120.0"
                        style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: white; -fx-cursor: hand;" />
                <Button fx:id="btnConfirmar" onAction="#onConfirmar" text="Abrir caixa" defaultButton="true" prefHeight="44.0" prefWidth="170.0"
                        style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;" />
            </children>
        </HBox>
    </children>
</VBox>
