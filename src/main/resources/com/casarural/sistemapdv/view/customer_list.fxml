<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.casarural.sistemapdv.controller.CustomerListController"
      style="-fx-background-color: #2c3e50;">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <HBox alignment="CENTER_LEFT" style="-fx-background-color: rgba(0,0,0,0.3); -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8;" spacing="15">
        <Label text="LISTA DE CLIENTES" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <Pane HBox.hgrow="ALWAYS"/>

        <TextField fx:id="campoPesquisa" promptText="Pesquisar por nome..." prefWidth="250" prefHeight="35" style="-fx-font-size: 14px;"/>

        <ComboBox fx:id="comboFiltroStatus" promptText="Status" prefWidth="130" prefHeight="35" style="-fx-font-size: 14px;"/>

        <ComboBox fx:id="comboFiltroOrdenacao" promptText="Ordenar por Dívida" prefWidth="170" prefHeight="35" style="-fx-font-size: 14px;"/>
    </HBox>

    <TableView fx:id="customerTable" VBox.vgrow="ALWAYS" style="-fx-font-size: 14px; -fx-background-color: transparent;">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60" />
            <TableColumn fx:id="nameColumn" text="Nome" prefWidth="180" />
            <TableColumn fx:id="creditStatusColumn" text="Situação Fiado" prefWidth="120" />
            <TableColumn fx:id="creditLimitColumn" text="Limite Crédito" prefWidth="120" />
            <TableColumn fx:id="totalDebtColumn" text="Total Devendo" prefWidth="120" />
            <TableColumn fx:id="actionsColumn" text="Ações" prefWidth="220" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>