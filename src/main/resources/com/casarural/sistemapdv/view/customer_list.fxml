<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Clientes: busca e filtros, tabela com situação e dívida; dois cliques abre a conta de fiado -->
<VBox styleClass="tela" spacing="0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.casarural.sistemapdv.controller.CustomerListController">

    <VBox styleClass="cabecalho" spacing="2">
        <Label styleClass="titulo" text="Clientes"/>
        <Label styleClass="subtitulo" text="Dê dois cliques num cliente para ver a conta de fiado e receber pagamentos."/>
    </VBox>

    <VBox styleClass="cartao" spacing="12" VBox.vgrow="ALWAYS">
        <VBox.margin><Insets top="18" right="24" bottom="20" left="24"/></VBox.margin>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <TextField fx:id="campoPesquisa" promptText="Buscar pelo nome" prefWidth="280" prefHeight="36"/>
            <ComboBox fx:id="comboFiltroStatus" promptText="Situação" prefWidth="150" prefHeight="36"/>
            <ComboBox fx:id="comboFiltroOrdenacao" promptText="Ordenar por dívida" prefWidth="180" prefHeight="36"/>
        </HBox>

        <TableView fx:id="customerTable" VBox.vgrow="ALWAYS">
            <placeholder><Label text="Nenhum cliente encontrado."/></placeholder>
            <columns>
                <TableColumn fx:id="idColumn" text="Nº" prefWidth="50"/>
                <TableColumn fx:id="nameColumn" text="NOME" prefWidth="200"/>
                <TableColumn fx:id="phoneColumn" text="CELULAR" prefWidth="130"/>
                <TableColumn fx:id="creditStatusColumn" text="FIADO" prefWidth="110"/>
                <TableColumn fx:id="creditLimitColumn" text="LIMITE" prefWidth="110"/>
                <TableColumn fx:id="totalDebtColumn" text="DEVENDO" prefWidth="110"/>
                <TableColumn fx:id="actionsColumn" text="AÇÕES" prefWidth="240" minWidth="230"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
