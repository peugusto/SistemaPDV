<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Estoque: busca por nome ou código, tabela com estoque baixo em vermelho e produtos sem fiado marcados -->
<VBox styleClass="tela" spacing="0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.casarural.sistemapdv.controller.ProductListController">

    <VBox styleClass="cabecalho" spacing="2">
        <Label styleClass="titulo" text="Estoque"/>
        <Label styleClass="subtitulo" text="Estoque em vermelho: 15 unidades ou menos."/>
    </VBox>

    <VBox styleClass="cartao" spacing="12" VBox.vgrow="ALWAYS">
        <VBox.margin><Insets top="18" right="24" bottom="20" left="24"/></VBox.margin>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <TextField fx:id="searchField" promptText="Buscar por nome ou código de barras" prefWidth="340" prefHeight="36"/>
            <Button fx:id="searchButton" text="Buscar" prefHeight="36"/>
        </HBox>

        <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
            <placeholder><Label text="Nenhum produto encontrado."/></placeholder>
            <columns>
                <TableColumn fx:id="idColumn" text="Nº" prefWidth="50"/>
                <TableColumn fx:id="barcodeColumn" text="CÓDIGO DE BARRAS" prefWidth="150"/>
                <TableColumn fx:id="nameColumn" text="PRODUTO" prefWidth="240"/>
                <TableColumn fx:id="priceColumn" text="PREÇO" prefWidth="100"/>
                <TableColumn fx:id="stockColumn" text="ESTOQUE" prefWidth="90"/>
                <TableColumn fx:id="fiadoColumn" text="FIADO" prefWidth="100"/>
                <TableColumn fx:id="actionsColumn" text="AÇÕES" prefWidth="180" minWidth="170"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
