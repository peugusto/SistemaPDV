<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.casarural.sistemapdv.controller.ProductListController"
      style="-fx-background-color: #2c3e50;">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <HBox alignment="CENTER_LEFT" style="-fx-background-color: rgba(0,0,0,0.3); -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8;" spacing="15">
        <Label text="ESTOQUE DE PRODUTOS" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <Pane HBox.hgrow="ALWAYS"/>

        <TextField fx:id="searchField" promptText="Pesquisar por nome ou código de barras..." prefWidth="320" prefHeight="35" style="-fx-font-size: 14px;"/>

        <Button fx:id="searchButton" text="Buscar" prefHeight="35" prefWidth="100" style="-fx-font-size: 14px; -fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 4; -fx-background-radius: 4;"/>
    </HBox>

    <TableView fx:id="productTable" VBox.vgrow="ALWAYS" style="-fx-font-size: 14px; -fx-background-color: transparent;">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="barcodeColumn" text="Código de Barras" prefWidth="150" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="nameColumn" text="Nome do Produto" prefWidth="250" style="-fx-alignment: CENTER-LEFT;" />
            <TableColumn fx:id="priceColumn" text="Preço" prefWidth="120" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="stockColumn" text="Estoque" prefWidth="100" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="actionsColumn" text="Ações" prefWidth="150" style="-fx-alignment: CENTER;" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>