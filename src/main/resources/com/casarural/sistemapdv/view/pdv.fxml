<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- PDV: último item em destaque no topo, leitura à esquerda, cupom à direita, ações embaixo -->
<BorderPane styleClass="tela" xmlns:fx="http://javafx.com/fxml" fx:controller="com.casarural.sistemapdv.controller.PDVController">

    <top>
        <StackPane styleClass="pdv-banner">
            <Label fx:id="labelUltimoItem" text="CAIXA LIVRE"/>
        </StackPane>
    </top>

    <center>
        <HBox spacing="22" alignment="CENTER">
            <padding>
                <Insets top="24" right="28" bottom="24" left="28"/>
            </padding>

            <!-- Leitura do produto -->
            <VBox styleClass="cartao" spacing="10" HBox.hgrow="ALWAYS" maxWidth="620">
                <Label styleClass="rotulo-secao" text="CÓDIGO DE BARRAS"/>
                <TextField fx:id="campoCodigoProduto" styleClass="campo-grande" promptText="Passe o leitor, digite o código ou aperte F2"/>

                <Label styleClass="rotulo-secao" text="QUANTIDADE">
                    <VBox.margin><Insets top="6"/></VBox.margin>
                </Label>
                <TextField fx:id="campoQuantidade" styleClass="campo-grande" text="1"/>

                <HBox spacing="14">
                    <VBox.margin><Insets top="6"/></VBox.margin>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label styleClass="rotulo-secao" text="VALOR UNITÁRIO"/>
                        <TextField fx:id="campoValorUnitario" styleClass="campo-grande,campo-leitura" editable="false" focusTraversable="false" text="0,00"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label styleClass="rotulo-secao" text="TOTAL DO ITEM"/>
                        <TextField fx:id="campoTotalItem" styleClass="campo-grande,campo-leitura" editable="false" focusTraversable="false" text="0,00"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Cupom -->
            <VBox styleClass="cartao" spacing="8" prefWidth="470" minWidth="420">
                <Label styleClass="titulo-cartao" text="Cupom da venda"/>
                <HBox spacing="10">
                    <padding><Insets top="6" bottom="2" left="6"/></padding>
                    <Label styleClass="rotulo-secao" text="QTD" prefWidth="40"/>
                    <Label styleClass="rotulo-secao" text="PRODUTO" prefWidth="200"/>
                    <Label styleClass="rotulo-secao" text="UNIT." prefWidth="70"/>
                    <Label styleClass="rotulo-secao" text="TOTAL" prefWidth="70"/>
                </HBox>
                <ListView fx:id="listaItens" VBox.vgrow="ALWAYS"/>
                <Separator/>
                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <Label styleClass="rotulo-secao" text="TOTAL"/>
                    <Label fx:id="labelTotal" styleClass="valor-destaque" text="R$ 0,00"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox styleClass="barra-inferior" spacing="12" alignment="CENTER_LEFT">
            <Button fx:id="botaoAdicionar" text="Adicionar (Enter)" minHeight="46"/>
            <Button fx:id="botaoBuscar" styleClass="botao-info" text="Buscar produto (F2)" minHeight="46"/>
            <Button fx:id="botaoRemover" text="Excluir item" minHeight="46"/>
            <Button fx:id="botaoLimpar" text="Cancelar venda (Esc)" minHeight="46"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="botaoFinalizar" styleClass="botao-primario,botao-grande" text="Finalizar venda (F1)" minWidth="270" minHeight="56"/>
        </HBox>
    </bottom>

</BorderPane>
