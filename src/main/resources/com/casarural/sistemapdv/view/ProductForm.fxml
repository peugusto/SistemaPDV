<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Edição de produto (aberta pela lista de estoque) -->
<VBox styleClass="tela" prefWidth="480.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.casarural.sistemapdv.controller.ProductFormController">

    <VBox styleClass="cabecalho" spacing="2">
        <Label styleClass="titulo" text="Editar produto"/>
        <Label styleClass="subtitulo" text="Altere os dados e clique em Salvar."/>
    </VBox>

    <GridPane styleClass="cartao" hgap="14" vgap="14">
        <VBox.margin><Insets top="20" right="24" bottom="8" left="24"/></VBox.margin>
        <columnConstraints>
            <ColumnConstraints minWidth="130"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label styleClass="rotulo" text="Código de barras" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtCodBarras" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label styleClass="rotulo" text="Nome do produto" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtNome" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label styleClass="rotulo" text="Como vende" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <CheckBox fx:id="chkPesavel" text="Pesável (digita o valor da balança)" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label fx:id="lblPreco" styleClass="rotulo" text="Preço (R$)" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtPreco" maxWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label fx:id="lblCusto" styleClass="rotulo" text="Custo (R$)" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="4" GridPane.columnIndex="1">
            <TextField fx:id="txtCusto" promptText="quanto você pagou" maxWidth="160"/>
            <Label fx:id="lblMargem" styleClass="texto-suave" wrapText="true"/>
        </HBox>


        <Label styleClass="rotulo" text="Estoque" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <CheckBox fx:id="chkControlaEstoque" text="Controlar estoque" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <Label styleClass="rotulo" text="Estoque atual" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <TextField fx:id="txtEstoque" maxWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

        <Label styleClass="rotulo" text="Fiado" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
        <CheckBox fx:id="chkPermiteFiado" text="Pode vender no fiado" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

        <Label styleClass="rotulo" text="Situação" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
        <CheckBox fx:id="chkAtivo" text="Produto ativo (aparece na venda)" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <padding><Insets top="12" right="24" bottom="22" left="24"/></padding>
        <Button fx:id="btnCancel" text="Cancelar" onAction="#onBtnCancelAction"/>
        <Button fx:id="btnSave" styleClass="botao-primario" text="Salvar" onAction="#onBtnSaveAction"/>
    </HBox>
</VBox>
