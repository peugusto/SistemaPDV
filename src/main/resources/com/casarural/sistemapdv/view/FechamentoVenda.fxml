<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="25" alignment="TOP_CENTER" xmlns:fx="http://javafx.com/fxml" fx:controller="com.casarural.sistemapdv.controller.PaymentController"
      style="-fx-background-color: -fx-secondary-color;" stylesheets="@seu_arquivo.css">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <VBox alignment="CENTER" spacing="5" style="-fx-background-color: rgba(0,0,0,0.2); -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8;">
        <Label text="TOTAL A PAGAR" style="-fx-font-size: 16px; -fx-text-fill: #bdc3c7; -fx-font-weight: bold;"/>
        <Label fx:id="labelTotalPagamento" text="R$ 0,00"
               style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
    </VBox>

    <fx:define>
        <ToggleGroup fx:id="grupoPagamento"/>
    </fx:define>

    <HBox spacing="15" alignment="CENTER">
        <ToggleButton fx:id="btnDinheiro" text="DINHEIRO" toggleGroup="$grupoPagamento" selected="true"
                      prefWidth="120" prefHeight="90"/>

        <ToggleButton fx:id="btnCartao" text="CARTÃO" toggleGroup="$grupoPagamento"
                      prefWidth="120" prefHeight="90"/>

        <ToggleButton fx:id="btnPix" text="PIX" toggleGroup="$grupoPagamento"
                      prefWidth="120" prefHeight="90"/>

        <ToggleButton fx:id="btnFiado" text="FIADO" toggleGroup="$grupoPagamento"
                      prefWidth="120" prefHeight="90"/>
    </HBox>

    <GridPane hgap="15" vgap="20" alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints minWidth="180" halignment="RIGHT"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="280"/>
        </columnConstraints>

        <Label text="Cliente (Fiado):" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="comboCliente" maxWidth="Infinity" prefHeight="40" promptText="Selecione o cliente..."
                  GridPane.columnIndex="1" GridPane.rowIndex="0" disable="true" style="-fx-font-size: 14px;"/>

        <Label text="Valor Recebido (R$):" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtValorRecebido" promptText="0,00" prefHeight="40"
                   GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Label text="Troco:" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label fx:id="labelTroco" text="R$ 0,00" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"
               GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <Pane VBox.vgrow="ALWAYS"/>

    <HBox spacing="20" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancelar" text="Voltar (Esc)" prefWidth="150" prefHeight="50" style="-fx-font-size: 16px;"/>
        <Button fx:id="btnConfirmar" text="Confirmar Pagamento" prefWidth="250" prefHeight="50"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
    </HBox>

</VBox>