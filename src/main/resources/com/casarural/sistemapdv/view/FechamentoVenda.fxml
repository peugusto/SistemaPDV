<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Pagamento da venda: total, formas de pagamento em blocos grandes, valor recebido e troco -->
<VBox styleClass="tela" spacing="0" xmlns:fx="http://javafx.com/fxml" fx:controller="com.casarural.sistemapdv.controller.PaymentController">

    <VBox styleClass="cabecalho" spacing="2">
        <Label styleClass="titulo" text="Pagamento"/>
        <Label styleClass="subtitulo" text="Escolha a forma, digite o valor recebido e confirme."/>
    </VBox>

    <VBox spacing="20" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="24" right="36" bottom="24" left="36"/>
        </padding>

        <VBox styleClass="cartao" alignment="CENTER" spacing="2">
            <Label styleClass="rotulo-secao" text="FALTA PAGAR"/>
            <Label fx:id="labelTotalPagamento" styleClass="valor-destaque" text="R$ 0,00"/>
            <!-- Total da compra, desconto e já lançado; na troca, o crédito e o que devolver -->
            <Label fx:id="labelResumo" styleClass="texto-suave" wrapText="true" textAlignment="CENTER"/>
            <Label fx:id="labelTroca" styleClass="etiqueta,etiqueta-info" wrapText="true" textAlignment="CENTER"
                   visible="false" managed="false"/>
        </VBox>

        <fx:define>
            <ToggleGroup fx:id="grupoPagamento"/>
        </fx:define>

        <HBox spacing="14" alignment="CENTER">
            <ToggleButton fx:id="btnDinheiro" styleClass="opcao-grande" text="DINHEIRO" toggleGroup="$grupoPagamento" selected="true"
                          prefWidth="140" prefHeight="80"/>
            <ToggleButton fx:id="btnCartao" styleClass="opcao-grande" text="CARTÃO" toggleGroup="$grupoPagamento"
                          prefWidth="140" prefHeight="80"/>
            <ToggleButton fx:id="btnPix" styleClass="opcao-grande" text="PIX" toggleGroup="$grupoPagamento"
                          prefWidth="140" prefHeight="80"/>
            <ToggleButton fx:id="btnFiado" styleClass="opcao-grande" text="FIADO" toggleGroup="$grupoPagamento"
                          prefWidth="140" prefHeight="80"/>
        </HBox>

        <GridPane styleClass="cartao" hgap="16" vgap="16" alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints minWidth="170" halignment="RIGHT"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="300"/>
            </columnConstraints>

            <Label styleClass="rotulo" text="Cliente (fiado):" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="comboCliente" maxWidth="Infinity" prefHeight="40" promptText="Escolha o cliente"
                      GridPane.columnIndex="1" GridPane.rowIndex="0" disable="true"/>

            <Label styleClass="rotulo" text="Valor recebido (R$):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtValorRecebido" styleClass="campo-grande" promptText="0,00"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label styleClass="rotulo" text="Troco:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label fx:id="labelTroco" styleClass="valor-grande" text="R$ 0,00"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>

        <Pane VBox.vgrow="ALWAYS"/>

        <HBox spacing="14" alignment="CENTER_RIGHT">
            <Button fx:id="btnDesconto" text="Desconto (F4)" prefWidth="160" prefHeight="50"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnCancelar" text="Voltar (Esc)" prefWidth="150" prefHeight="50"/>
            <Button fx:id="btnConfirmar" styleClass="botao-primario,botao-grande" text="Confirmar pagamento" prefWidth="260" prefHeight="54"/>
        </HBox>
    </VBox>

</VBox>
