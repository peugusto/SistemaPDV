<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Fechamento do caixa. Esquerda: conta do dinheiro na gaveta (calculada pelo sistema).
  Direita: o que entrou em PIX/cartão, o que foi vendido no fiado, sangrias/reforços do dia.
  Embaixo: contagem opcional da gaveta, diferença e observação.
-->
<VBox styleClass="tela" prefWidth="900.0" spacing="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.casarural.sistemapdv.controller.FecharCaixaController">
    <children>
        <VBox styleClass="cabecalho" spacing="2.0">
            <children>
                <Label styleClass="titulo" text="Fechar caixa" />
                <Label fx:id="labelAberto" styleClass="subtitulo" text="Aberto em 00/00/0000 às 00:00" />
            </children>
        </VBox>

        <HBox spacing="18.0">
            <padding><Insets bottom="0.0" left="24.0" right="24.0" top="20.0" /></padding>
            <children>
                <!-- Dinheiro na gaveta -->
                <VBox styleClass="cartao" spacing="10.0" HBox.hgrow="ALWAYS" prefWidth="420.0">
                    <children>
                        <Label styleClass="rotulo-secao" text="DINHEIRO NA GAVETA" />
                        <GridPane hgap="12.0" vgap="9.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" />
                                <ColumnConstraints halignment="RIGHT" />
                            </columnConstraints>
                            <children>
                                <Label text="Troco inicial" GridPane.rowIndex="0" />
                                <Label fx:id="valTroco" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                <Label text="+ Vendas em dinheiro" GridPane.rowIndex="1" />
                                <Label fx:id="valVendasDinheiro" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label text="+ Fiado recebido em dinheiro" GridPane.rowIndex="2" />
                                <Label fx:id="valFiadoDinheiro" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <Label text="+ Dinheiro colocado (reforços)" GridPane.rowIndex="3" />
                                <Label fx:id="valReforcos" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                <Label text="− Dinheiro retirado (sangrias)" GridPane.rowIndex="4" />
                                <Label fx:id="valSangrias" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                <Separator GridPane.columnSpan="2" GridPane.rowIndex="5" />
                                <Label styleClass="texto-forte" text="= Deve ter na gaveta" GridPane.rowIndex="6" />
                                <Label fx:id="valEsperado" styleClass="valor-destaque" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <!-- Outras formas e movimentos -->
                <VBox styleClass="cartao" spacing="10.0" HBox.hgrow="ALWAYS" prefWidth="420.0">
                    <children>
                        <Label styleClass="rotulo-secao" text="OUTRAS ENTRADAS (NÃO FICAM NA GAVETA)" />
                        <GridPane hgap="12.0" vgap="9.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" />
                                <ColumnConstraints halignment="RIGHT" />
                            </columnConstraints>
                            <children>
                                <Label text="PIX (vendas + fiado recebido)" GridPane.rowIndex="0" />
                                <Label fx:id="valPix" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                <Label text="Cartão (vendas + fiado recebido)" GridPane.rowIndex="1" />
                                <Label fx:id="valCartao" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label text="Vendido no fiado (a receber)" GridPane.rowIndex="2" />
                                <Label fx:id="valFiadoVendido" styleClass="texto-alerta" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <Separator GridPane.columnSpan="2" GridPane.rowIndex="3" />
                                <Label styleClass="texto-forte" text="Total vendido no dia" GridPane.rowIndex="4" />
                                <Label fx:id="valTotalVendido" styleClass="texto-forte" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                <Label styleClass="texto-forte" text="Total de fiado recebido" GridPane.rowIndex="5" />
                                <Label fx:id="valFiadoRecebido" styleClass="texto-forte" text="R$ 0,00" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                            </children>
                        </GridPane>
                        <Label styleClass="rotulo-secao" text="RETIRADAS E REFORÇOS DO DIA">
                            <VBox.margin><Insets top="6.0" /></VBox.margin>
                        </Label>
                        <ListView fx:id="listaMovimentos" prefHeight="90.0">
                            <placeholder><Label styleClass="texto-suave" text="Nenhuma retirada ou reforço." /></placeholder>
                        </ListView>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Conferência (opcional) -->
        <HBox styleClass="cartao" alignment="CENTER_LEFT" spacing="16.0">
            <VBox.margin><Insets bottom="0.0" left="24.0" right="24.0" top="18.0" /></VBox.margin>
            <children>
                <VBox spacing="6.0">
                    <children>
                        <Label styleClass="rotulo-secao" text="CONTEI NA GAVETA (OPCIONAL)" />
                        <TextField fx:id="campoContado" styleClass="campo-grande" promptText="deixe vazio se não contou" prefWidth="240.0" />
                    </children>
                </VBox>
                <VBox spacing="6.0" minWidth="180">
                    <children>
                        <Label styleClass="rotulo-secao" text="RESULTADO" />
                        <Label fx:id="labelDiferenca" styleClass="valor-grande" text="Não conferido" />
                    </children>
                </VBox>
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="rotulo-secao" text="OBSERVAÇÃO" />
                        <TextField fx:id="campoObservacao" promptText="opcional" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <padding><Insets bottom="22.0" left="24.0" right="24.0" top="16.0" /></padding>
            <children>
                <Button onAction="#onCancelar" text="Cancelar" prefHeight="46.0" prefWidth="130.0" />
                <Button fx:id="btnFechar" styleClass="botao-perigo" onAction="#onFecharCaixa" text="Fechar caixa" prefHeight="46.0" prefWidth="180.0" />
            </children>
        </HBox>
    </children>
</VBox>
