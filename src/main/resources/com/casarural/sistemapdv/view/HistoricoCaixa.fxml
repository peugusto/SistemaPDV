<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Caixas já fechados; ao selecionar um, o resumo daquele dia aparece embaixo -->
<VBox styleClass="tela" prefHeight="760.0" prefWidth="980.0" spacing="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.casarural.sistemapdv.controller.HistoricoCaixaController">
    <children>
        <VBox styleClass="cabecalho" spacing="2.0">
            <children>
                <Label styleClass="titulo" text="Histórico de caixas" />
                <Label styleClass="subtitulo" text="Últimos 90 caixas fechados. Selecione um para ver o resumo do dia." />
            </children>
        </VBox>
        <VBox styleClass="cartao" spacing="12.0" VBox.vgrow="ALWAYS">
            <VBox.margin><Insets bottom="20.0" left="24.0" right="24.0" top="18.0" /></VBox.margin>
            <children>
                <TableView fx:id="tabela" VBox.vgrow="ALWAYS" prefHeight="220.0" minHeight="150.0">
                    <placeholder><Label text="Nenhum caixa fechado ainda." /></placeholder>
                    <columns>
                        <TableColumn fx:id="colAbertura" prefWidth="150" text="ABERTURA" />
                        <TableColumn fx:id="colFechamento" prefWidth="150" text="FECHAMENTO" />
                        <TableColumn fx:id="colTroco" prefWidth="110" text="TROCO" />
                        <TableColumn fx:id="colEsperado" prefWidth="120" text="DEVIA TER" />
                        <TableColumn fx:id="colContado" prefWidth="120" text="CONTADO" />
                        <TableColumn fx:id="colDiferenca" prefWidth="140" text="RESULTADO" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
                <HBox alignment="CENTER_RIGHT"><children>
                    <Button fx:id="btnImprimir" text="Imprimir fechamento" onAction="#onImprimirAction" disable="true" minHeight="40.0" />
                </children></HBox>
                <Separator />
                <Label fx:id="labelResumo" styleClass="monoespacado" wrapText="true" text="Selecione um caixa para ver o resumo."
                       maxWidth="Infinity" minHeight="-Infinity" />
            </children>
        </VBox>
    </children>
</VBox>
