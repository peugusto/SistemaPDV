<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Caixas já fechados; ao selecionar um, o resumo daquele dia aparece embaixo -->
<VBox prefHeight="760.0" prefWidth="960.0" spacing="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.casarural.sistemapdv.controller.HistoricoCaixaController"
      style="-fx-background-color: #2c3e50;">
    <children>
        <VBox style="-fx-background-color: rgba(0,0,0,0.3);">
            <padding><Insets bottom="16.0" left="24.0" right="24.0" top="16.0" /></padding>
            <children>
                <Label text="HISTÓRICO DE CAIXAS" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />
                <Label text="Últimos 90 caixas fechados. Selecione um para ver o resumo do dia." style="-fx-font-size: 14px; -fx-text-fill: #bdc3c7;" />
            </children>
        </VBox>
        <VBox spacing="12.0" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="20.0" left="24.0" right="24.0" top="16.0" /></padding>
            <children>
                <TableView fx:id="tabela" VBox.vgrow="ALWAYS" prefHeight="220.0" minHeight="150.0" style="-fx-font-size: 14px;">
                    <placeholder><Label text="Nenhum caixa fechado ainda." /></placeholder>
                    <columns>
                        <TableColumn fx:id="colAbertura" prefWidth="150" text="Abertura" />
                        <TableColumn fx:id="colFechamento" prefWidth="150" text="Fechamento" />
                        <TableColumn fx:id="colTroco" prefWidth="110" text="Troco inicial" />
                        <TableColumn fx:id="colEsperado" prefWidth="120" text="Devia ter" />
                        <TableColumn fx:id="colContado" prefWidth="120" text="Contado" />
                        <TableColumn fx:id="colDiferenca" prefWidth="140" text="Resultado" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
                <Label fx:id="labelResumo" wrapText="true" text="Selecione um caixa para ver o resumo."
                       style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 14px; -fx-text-fill: white; -fx-background-color: rgba(0,0,0,0.2); -fx-background-radius: 8; -fx-padding: 14;"
                       maxWidth="Infinity" minHeight="-Infinity" />
            </children>
        </VBox>
    </children>
</VBox>
