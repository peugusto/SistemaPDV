<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Conta de fiado do cliente.
  Aba 1: compras em aberto (quanto foi pago na compra, quanto foi pago depois e quanto falta) + itens do pedido selecionado
  Aba 2: pagamentos recebidos (quando, como e quais pedidos foram abatidos)
  Aba 3: compras quitadas + itens
  Rodapé: receber pagamento, escolhendo a forma (dinheiro, PIX ou cartão)
-->
<VBox styleClass="tela" prefHeight="720.0" prefWidth="1060.0" spacing="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.casarural.sistemapdv.controller.FiadoListController">
    <children>
        <!-- Cabeçalho -->
        <HBox styleClass="cabecalho" alignment="CENTER_LEFT" spacing="20.0">
            <children>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="labelTitulo" styleClass="titulo" text="Conta de fiado" />
                        <Label fx:id="labelSituacao" styleClass="subtitulo" text="" />
                    </children>
                </VBox>
                <VBox alignment="CENTER_RIGHT" spacing="2.0">
                    <children>
                        <Label styleClass="subtitulo" text="TOTAL DEVENDO" />
                        <Label fx:id="labelTotalDevendo" styleClass="relogio" text="R$ 0,00" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Abas -->
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" minHeight="0.0">
            <VBox.margin><Insets top="16.0" right="24.0" left="24.0" /></VBox.margin>
            <tabs>
                <Tab text="Compras em aberto">
                    <content>
                        <VBox spacing="10.0">
                            <padding><Insets bottom="12.0" left="16.0" right="16.0" top="12.0" /></padding>
                            <children>
                                <TableView fx:id="tableAbertos" VBox.vgrow="ALWAYS" prefHeight="260.0" minHeight="80.0">
                                    <placeholder><Label text="Nenhuma compra em aberto." /></placeholder>
                                    <columns>
                                        <TableColumn fx:id="colAbertoData" prefWidth="140" text="Data da compra" />
                                        <TableColumn fx:id="colAbertoPedido" prefWidth="80" text="Pedido" />
                                        <TableColumn fx:id="colAbertoVence" prefWidth="190" text="Vence em" />
                                        <TableColumn fx:id="colAbertoTotal" prefWidth="130" text="Valor da compra" />
                                        <TableColumn fx:id="colAbertoPagoVenda" prefWidth="130" text="Pago na compra" />
                                        <TableColumn fx:id="colAbertoPagoDepois" prefWidth="130" text="Pago depois" />
                                        <TableColumn fx:id="colAbertoFalta" prefWidth="130" text="Falta pagar" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>
                                <Label fx:id="labelItensAberto" styleClass="texto-suave" text="Selecione uma compra para ver os produtos." />
                                <TableView fx:id="tableItensAberto" prefHeight="170.0" minHeight="80.0">
                                    <placeholder><Label text="" /></placeholder>
                                    <columns>
                                        <TableColumn fx:id="colItemAbertoProduto" prefWidth="300" text="Produto" />
                                        <TableColumn fx:id="colItemAbertoQtd" prefWidth="80" text="Qtd" />
                                        <TableColumn fx:id="colItemAbertoPreco" prefWidth="130" text="Vl. Unitário" />
                                        <TableColumn fx:id="colItemAbertoSubtotal" prefWidth="130" text="Subtotal" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Pagamentos recebidos">
                    <content>
                        <VBox spacing="10.0">
                            <padding><Insets bottom="12.0" left="16.0" right="16.0" top="12.0" /></padding>
                            <children>
                                <TableView fx:id="tableRecebimentos" VBox.vgrow="ALWAYS">
                                    <placeholder><Label text="Nenhum pagamento de fiado recebido ainda." /></placeholder>
                                    <columns>
                                        <TableColumn fx:id="colRecData" prefWidth="160" text="Data do pagamento" />
                                        <TableColumn fx:id="colRecForma" prefWidth="120" text="Forma" />
                                        <TableColumn fx:id="colRecValor" prefWidth="130" text="Valor" />
                                        <TableColumn fx:id="colRecPedidos" prefWidth="260" text="Compras abatidas" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>
                                <!-- Desfazer um recebimento lançado errado: só do caixa aberto, com PIN -->
                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="labelEstornoDica" styleClass="texto-dica" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                               text="Recebeu errado? Selecione o pagamento e clique em Estornar (só os do caixa aberto)." />
                                        <Button fx:id="btnEstornar" styleClass="botao-perigo,botao-pequeno" text="Estornar recebimento"
                                                onAction="#onEstornarAction" disable="true" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Compras quitadas">
                    <content>
                        <VBox spacing="10.0">
                            <padding><Insets bottom="12.0" left="16.0" right="16.0" top="12.0" /></padding>
                            <children>
                                <TableView fx:id="tableQuitados" VBox.vgrow="ALWAYS" prefHeight="260.0" minHeight="80.0">
                                    <placeholder><Label text="Nenhuma compra quitada." /></placeholder>
                                    <columns>
                                        <TableColumn fx:id="colQuitData" prefWidth="160" text="Data da compra" />
                                        <TableColumn fx:id="colQuitPedido" prefWidth="80" text="Pedido" />
                                        <TableColumn fx:id="colQuitTotal" prefWidth="130" text="Valor da compra" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>
                                <Label fx:id="labelItensQuitado" styleClass="texto-suave" text="Selecione uma compra para ver os produtos." />
                                <TableView fx:id="tableItensQuitado" prefHeight="170.0" minHeight="80.0">
                                    <placeholder><Label text="" /></placeholder>
                                    <columns>
                                        <TableColumn fx:id="colItemQuitProduto" prefWidth="300" text="Produto" />
                                        <TableColumn fx:id="colItemQuitQtd" prefWidth="80" text="Qtd" />
                                        <TableColumn fx:id="colItemQuitPreco" prefWidth="130" text="Vl. Unitário" />
                                        <TableColumn fx:id="colItemQuitSubtotal" prefWidth="130" text="Subtotal" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>

        <!-- Recebimento e impressão são ações independentes. Duas linhas evitam cortes na janela. -->
        <VBox styleClass="barra-inferior" spacing="10.0">
            <VBox.margin><Insets top="16.0" /></VBox.margin>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label styleClass="rotulo-secao" text="RECEBER PAGAMENTO" />
                        <fx:define><ToggleGroup fx:id="grupoForma" /></fx:define>
                        <ToggleButton fx:id="btnFormaDinheiro" styleClass="pilula" text="Dinheiro" toggleGroup="$grupoForma" selected="true" minHeight="40.0" minWidth="100.0" />
                        <ToggleButton fx:id="btnFormaPix" styleClass="pilula" text="PIX" toggleGroup="$grupoForma" minHeight="40.0" minWidth="80.0" />
                        <ToggleButton fx:id="btnFormaCartao" styleClass="pilula" text="Cartão" toggleGroup="$grupoForma" minHeight="40.0" minWidth="90.0" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                    <children>
                        <TextField fx:id="campoValorPagamento" promptText="Valor (vazio = tudo)" prefWidth="200" prefHeight="42" />
                        <Button fx:id="btnPagar" styleClass="botao-primario" onAction="#onPagarAction" minHeight="42.0" minWidth="150.0" text="Receber" />
                        <Button fx:id="btnImprimirDivida" onAction="#onImprimirDividaAction" minHeight="42.0" minWidth="150.0" text="Imprimir dívida">
                            <tooltip><Tooltip text="Imprimir as compras em aberto e o saldo devedor." /></tooltip>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
