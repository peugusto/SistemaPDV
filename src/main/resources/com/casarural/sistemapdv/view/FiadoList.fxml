<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.casarural.sistemapdv.controller.FiadoListController"
      style="-fx-background-color: #2c3e50;" stylesheets="@seu_arquivo.css">
    <children>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: rgba(0,0,0,0.3); -fx-border-width: 0 0 1 0; -fx-border-color: rgba(255,255,255,0.1);">
            <children>
                <Label fx:id="labelTitulo" text="DETALHAMENTO DE FIADO: [NOME DO CLIENTE]" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </HBox>

        <VBox spacing="15.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <TableView fx:id="tableFiados" VBox.vgrow="ALWAYS" style="-fx-font-size: 14px; -fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="columnData" prefWidth="120" text="Data da Venda" />
                        <TableColumn fx:id="columnProduto" prefWidth="250" text="Produto" />
                        <TableColumn fx:id="columnQtd" prefWidth="80" text="Qtd" />
                        <TableColumn fx:id="columnPrecoUnit" prefWidth="120" text="Vl. Unitário" />
                        <TableColumn fx:id="columnSubtotal" prefWidth="120" text="Subtotal" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-background-color: rgba(0,0,0,0.2); -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8;">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label text="Dívida Total:" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #bdc3c7;" />
                        <Label fx:id="labelTotalDevendo" text="R$ 0,00" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" />

                        <Pane HBox.hgrow="ALWAYS" />

                        <Label text="Valor (R$):" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;" />
                        <TextField fx:id="campoValorPagamento" promptText="0,00" prefWidth="120" prefHeight="40" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

                        <Button fx:id="btnPagar" onAction="#onPagarAction" prefHeight="40.0" prefWidth="180.0"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;"
                                text="RECEBER PAGAMENTO" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>