<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.casarural.sistemapdv.controller.OrderListController"
      style="-fx-background-color: #2c3e50;">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <HBox alignment="CENTER_LEFT" style="-fx-background-color: rgba(0,0,0,0.3); -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8;" spacing="15">
        <Label text="RELATÓRIO DE VENDAS" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <Pane HBox.hgrow="ALWAYS"/>

        <Label text="Início:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <DatePicker fx:id="dpDataInicio" prefWidth="130" prefHeight="35" style="-fx-font-size: 14px;"/>

        <Label text="Fim:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <DatePicker fx:id="dpDataFim" prefWidth="130" prefHeight="35" style="-fx-font-size: 14px;"/>

        <Button fx:id="btnFiltrar" text="Gerar Relatório" prefHeight="35" style="-fx-font-size: 14px; -fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 4; -fx-background-radius: 4;"/>
    </HBox>

    <TableView fx:id="tableViewItens" VBox.vgrow="ALWAYS" style="-fx-font-size: 14px; -fx-background-color: transparent;">
        <columns>
            <TableColumn fx:id="columnDataHora" text="Data/Hora" prefWidth="120" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="columnVendaId" text="Nº Venda" prefWidth="80" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="columnCodBarras" text="Cód. Barras" prefWidth="120" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="columnProduto" text="Produto" prefWidth="200" style="-fx-alignment: CENTER-LEFT;"/>
            <TableColumn fx:id="columnPreco" text="Preço Unit." prefWidth="100" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="columnQtd" text="Qtd." prefWidth="60" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="columnTotal" text="Total" prefWidth="100" style="-fx-alignment: CENTER;"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-background-color: rgba(0,0,0,0.3); -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8;">
        <Label text="Faturamento Bruto no Período:" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label fx:id="labelFaturamentoTotal" text="R$ 0,00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
    </HBox>
</VBox>