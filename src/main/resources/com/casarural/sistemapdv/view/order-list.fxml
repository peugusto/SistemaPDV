<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Histórico de vendas.
  Topo: filtros (período rápido ou datas, forma de pagamento, situação, cliente, produto).
  Esquerda: vendas encontradas. Direita: produtos e pagamentos da venda selecionada.
  Não mostra soma de valores (faturamento): esse dado fica para uma tela protegida.
-->
<VBox prefHeight="760.0" prefWidth="1280.0" spacing="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.casarural.sistemapdv.controller.OrderListController"
      style="-fx-background-color: #2c3e50;">
    <children>
        <!-- Cabeçalho -->
        <VBox spacing="2.0" style="-fx-background-color: rgba(0,0,0,0.3);">
            <padding><Insets bottom="14.0" left="24.0" right="24.0" top="16.0" /></padding>
            <children>
                <Label text="HISTÓRICO DE VENDAS" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />
                <Label text="Encontre uma venda pelo período, forma de pagamento, cliente ou produto." style="-fx-font-size: 14px; -fx-text-fill: #bdc3c7;" />
            </children>
        </VBox>

        <!-- Filtros -->
        <VBox spacing="12.0" style="-fx-background-color: rgba(0,0,0,0.15); -fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 0 1 0;">
            <padding><Insets bottom="14.0" left="24.0" right="24.0" top="14.0" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label text="Período" minWidth="70" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #bdc3c7;" />
                        <fx:define><ToggleGroup fx:id="grupoPeriodo" /></fx:define>
                        <ToggleButton fx:id="btnHoje" text="Hoje" toggleGroup="$grupoPeriodo" selected="true" prefHeight="34" />
                        <ToggleButton fx:id="btnOntem" text="Ontem" toggleGroup="$grupoPeriodo" prefHeight="34" />
                        <ToggleButton fx:id="btn7Dias" text="Últimos 7 dias" toggleGroup="$grupoPeriodo" prefHeight="34" />
                        <ToggleButton fx:id="btnMes" text="Este mês" toggleGroup="$grupoPeriodo" prefHeight="34" />
                        <Pane prefWidth="16" />
                        <Label text="De" style="-fx-font-size: 13px; -fx-text-fill: white;" />
                        <DatePicker fx:id="dpInicio" prefWidth="140" prefHeight="34" />
                        <Label text="até" style="-fx-font-size: 13px; -fx-text-fill: white;" />
                        <DatePicker fx:id="dpFim" prefWidth="140" prefHeight="34" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label text="Filtrar" minWidth="70" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #bdc3c7;" />
                        <ComboBox fx:id="comboForma" prefWidth="170" prefHeight="34" promptText="Forma de pagamento" />
                        <ComboBox fx:id="comboSituacao" prefWidth="170" prefHeight="34" promptText="Situação" />
                        <TextField fx:id="campoCliente" promptText="Cliente (fiado)" prefWidth="190" prefHeight="34" />
                        <TextField fx:id="campoProduto" promptText="Produto ou código de barras" prefWidth="240" prefHeight="34" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnLimpar" text="Limpar filtros" onAction="#onLimparFiltros" prefHeight="34"
                                style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6;" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Vendas + detalhe -->
        <HBox spacing="16.0" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="12.0" left="24.0" right="24.0" top="16.0" /></padding>
            <children>
                <TableView fx:id="tabelaVendas" HBox.hgrow="ALWAYS" style="-fx-font-size: 14px;">
                    <placeholder><Label text="Nenhuma venda encontrada com esses filtros." /></placeholder>
                    <columns>
                        <TableColumn fx:id="colData" prefWidth="140" text="Data e hora" />
                        <TableColumn fx:id="colNumero" prefWidth="70" text="Venda" />
                        <TableColumn fx:id="colCliente" prefWidth="150" text="Cliente" />
                        <TableColumn fx:id="colItens" prefWidth="60" text="Itens" />
                        <TableColumn fx:id="colFormas" prefWidth="170" text="Pagamento" />
                        <TableColumn fx:id="colValor" prefWidth="100" text="Valor" />
                        <TableColumn fx:id="colSituacao" prefWidth="105" text="Situação" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>

                <VBox spacing="10.0" prefWidth="420.0" minWidth="380.0"
                      style="-fx-background-color: rgba(0,0,0,0.2); -fx-background-radius: 8; -fx-padding: 16;">
                    <children>
                        <Label fx:id="labelVendaTitulo" text="Selecione uma venda" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
                        <Label fx:id="labelVendaInfo" wrapText="true" text="Os produtos e os pagamentos da venda aparecem aqui." style="-fx-font-size: 13px; -fx-text-fill: #bdc3c7;" />
                        <Label text="PRODUTOS" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #bdc3c7;">
                            <VBox.margin><Insets top="6.0" /></VBox.margin>
                        </Label>
                        <TableView fx:id="tabelaItens" VBox.vgrow="ALWAYS" prefHeight="220.0" style="-fx-font-size: 13px;">
                            <placeholder><Label text="" /></placeholder>
                            <columns>
                                <TableColumn fx:id="colItemProduto" prefWidth="170" text="Produto" />
                                <TableColumn fx:id="colItemQtd" prefWidth="45" text="Qtd" />
                                <TableColumn fx:id="colItemPreco" prefWidth="80" text="Unitário" />
                                <TableColumn fx:id="colItemSubtotal" prefWidth="80" text="Subtotal" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                        </TableView>
                        <Label text="PAGAMENTOS" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #bdc3c7;" />
                        <ListView fx:id="listaPagamentos" prefHeight="130.0" style="-fx-font-size: 13px;">
                            <placeholder><Label text="" /></placeholder>
                        </ListView>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Rodapé: só a contagem, sem somar valores -->
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: rgba(0,0,0,0.3);">
            <padding><Insets bottom="10.0" left="24.0" right="24.0" top="10.0" /></padding>
            <children>
                <Label fx:id="labelContagem" text="" style="-fx-font-size: 13px; -fx-text-fill: #bdc3c7;" />
            </children>
        </HBox>
    </children>
</VBox>
