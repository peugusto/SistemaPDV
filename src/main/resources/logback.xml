<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuração dos logs do SistemaPDV.

  Onde fica o arquivo:
    C:\ProgramData\SistemaPDV\logs\sistemapdv.log   (dia atual)
    C:\ProgramData\SistemaPDV\logs\sistemapdv.2026-10-10.0.log   (dias anteriores)
  Para mudar a pasta sem recompilar:  java -Dpdv.logdir=D:\outra\pasta ...

  Regras de retenção: um arquivo por dia, no máximo 10 MB cada (se passar, abre .1, .2...),
  guarda 30 dias e nunca ocupa mais de 300 MB no total.

  Níveis, do mais grave ao mais detalhado: ERROR > WARN > INFO > DEBUG > TRACE.
  O nível configurado grava ele e todos os mais graves (INFO grava INFO, WARN e ERROR).
-->
<configuration>

    <!-- ${ProgramData} vem da variável de ambiente do Windows; se não existir, usa C:/ProgramData -->
    <property name="LOG_DIR" value="${pdv.logdir:-${ProgramData:-C:/ProgramData}/SistemaPDV/logs}" />
    <property name="PADRAO" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n" />

    <!-- Console: aparece na IntelliJ durante o desenvolvimento -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PADRAO}</pattern>
        </encoder>
    </appender>

    <!-- Arquivo: é o que você lê à distância no computador da loja -->
    <appender name="ARQUIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/sistemapdv.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/sistemapdv.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${PADRAO}</pattern>
        </encoder>
    </appender>

    <!-- Bibliotecas: só o que importa (início do pool, migrações, avisos e erros) -->
    <logger name="com.zaxxer.hikari" level="INFO" />
    <logger name="org.flywaydb" level="INFO" />

    <!-- O próprio sistema -->
    <logger name="com.casarural.sistemapdv" level="INFO" />

    <root level="WARN">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ARQUIVO" />
    </root>
</configuration>
